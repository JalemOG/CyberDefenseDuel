<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.CharacterSelectionController">
   <children>
      <ImageView fitHeight="500.0" fitWidth="800.0">
         <image>
            <Image url="@assets/characters.png" />
         </image>
      </ImageView>
      <Label layoutX="246.0" layoutY="14.0" prefHeight="58.0" prefWidth="309.0" text="CHOOSE YOUR CHARACTER">
         <font>
            <Font name="Bodoni MT Poster Compressed" size="48.0" />
         </font>
      </Label>
      <Button layoutX="63.0" layoutY="216.0" mnemonicParsing="false" onAction="#botonByteNinja" text="BYTE NINJA" />
      <Button layoutX="237.0" layoutY="136.0" mnemonicParsing="false" onAction="#botonPacketPirate" prefHeight="25.0" prefWidth="101.0" text="PACKET PIRATE" />
      <Button layoutX="555.0" layoutY="136.0" mnemonicParsing="false" onAction="#botonCaptainFirewall" text="CAPTAIN FIREWALL" />
      <Button layoutX="54.0" layoutY="420.0" mnemonicParsing="false" onAction="#botonMalwareMuncher" prefHeight="25.0" prefWidth="133.0" text="MALWARE MUNCHER" />
      <Button layoutX="327.0" layoutY="445.0" mnemonicParsing="false" onAction="#botonNullPointerPaladin" text="NULL POINTER PALADIN" />
      <Button layoutX="633.0" layoutY="298.0" mnemonicParsing="false" onAction="#botonCryptoLlama" text="CRYPTO LLAMA" />
   </children>
</AnchorPane>